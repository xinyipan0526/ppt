# Never commit real credentials. Copy this file to .env for local use.
PPT_AGENT_PROVIDER_MODE=deterministic
PPT_AGENT_WORKSPACE=./workspace
PPT_AGENT_HOST=127.0.0.1
PPT_AGENT_PORT=8000
# Use the OS path separator: ';' on Windows, ':' on Linux.
PPT_AGENT_FONT_ROOTS=C:/Windows/Fonts

# Cloud mode only
ARK_API_KEY=
PPT_AGENT_MULTIMODAL_MODEL_ID=doubao-seed-2-1-pro-260915
PPT_AGENT_IMAGE_MODEL_ID=doubao-seedream-5-0-pro-260628
# Container/secret-manager alternative:
# ARK_API_KEY_FILE=/run/secrets/ark_api_key

# Legacy provider settings below are retained for rollback only and do not
# qualify the current cloud runtime.
DEEPSEEK_API_KEY=
SEEDREAM_API_KEY=
QWEN_API_KEY=
# Container/secret-manager alternative (direct values take precedence):
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
# SEEDREAM_API_KEY_FILE=/run/secrets/seedream_api_key
# QWEN_API_KEY_FILE=/run/secrets/qwen_api_key
PPT_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
PPT_AGENT_SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PPT_AGENT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPT_AGENT_DEEPSEEK_MODEL=deepseek-chat
PPT_AGENT_SEEDREAM_MODEL=doubao-seedream-4-0-250828
PPT_AGENT_QWEN_VISION_MODEL=qwen-vl-max
PPT_AGENT_QWEN_OCR_MODEL=qwen-vl-ocr-latest
# Comma-separated exact hosts that Seedream result URLs may use.
PPT_AGENT_SEEDREAM_RESULT_HOSTS=

# Minor currency units. Update whenever provider pricing changes.
PPT_AGENT_PRICING_CURRENCY=CNY
PPT_AGENT_PRICING_VERSION=account-prices-YYYY-MM-DD
PPT_AGENT_DEEPSEEK_INPUT_PER_MILLION=0
PPT_AGENT_DEEPSEEK_OUTPUT_PER_MILLION=0
PPT_AGENT_DEEPSEEK_CACHED_INPUT_PER_MILLION=0
PPT_AGENT_SEEDREAM_PER_IMAGE=0
PPT_AGENT_QWEN_INPUT_PER_MILLION=0
PPT_AGENT_QWEN_OUTPUT_PER_MILLION=0
